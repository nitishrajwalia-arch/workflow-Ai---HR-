// Marbella HR — database schema.
//
// THREE THINGS THAT ARE NOT THE SAME THING, AND ONE THAT SHIPPED AS A BUG ONCE
// ---------------------------------------------------------------------------
//  * Company  — the legal entity that PAYS someone. Drives the letterhead, the PF
//               challan, the experience certificate. Get it wrong and the paper is
//               worthless.
//  * Project  — a development (Marbella Grand, Curo One). Belongs to a Company.
//               Several projects share one company.
//  * Office   — a place a person is POSTED AT. Usually a project's site office, but
//               the Head Office is an Office with no Project, and Manifest is a
//               Project with no Office. Modelling these as one table is what makes
//               "who employs them" and "where they sit" quietly drift apart.
//
// A Person therefore carries BOTH officeId (posted at) and employerId (paid by),
// and neither is derived from the other.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 keeps the connection URL out of the schema: migrations read it from
// prisma.config.ts, and the running client is given an explicit driver adapter
// (see src/db.ts). That means the pool is ours to size and the schema file holds
// no secrets.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- identity

enum Role {
  ADMIN
  HR
  MANAGER
  VIEWER
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String
  /// The Employee ID people actually sign in with, e.g. MB-PUR-0012. Unique and
  /// optional: a service account has no employee record.
  employeeId         String?   @unique
  /// Which desk this account sees: admin | purchase | store | maintenance |
  /// accounts | hr | purchaseAsst | storeAsst | security. It drives the left-hand
  /// nav, so it is the SERVER's answer to "who are you", never the browser's.
  userKey            String    @default("viewer")
  /// Argon2id. Never a plain hash, never reversible, never logged.
  passwordHash       String
  role               Role      @default(VIEWER)
  /// The employee record this login belongs to, when there is one.
  personId           String?
  person             Person?   @relation(fields: [personId], references: [id], onDelete: SetNull)
  mustChangePassword Boolean   @default(false)
  /// Set instead of deleting: a departed user's audit trail must keep resolving.
  disabledAt         DateTime?
  lastLoginAt        DateTime?
  failedLogins       Int       @default(0)
  /// Set when failedLogins crosses the threshold; login is refused until it passes.
  lockedUntil        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  refreshTokens RefreshToken[]
  docs          DocLog[]
  exitSteps     ExitStep[]

  @@index([personId])
  @@map("app_user")
}

/// One row per issued refresh token. Rotating: using one revokes it and issues the
/// next, so a stolen token is usable at most once and its reuse is detectable.
model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the token. The token itself is never stored.
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  /// Set when this token was rotated; lets us spot a replayed old token.
  replacedById String?
  userAgent    String?
  ip           String?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_token")
}

// ------------------------------------------------------- entities and places

model Company {
  id        String   @id
  name      String
  kind      String   @default("")
  /// Shape-checked. NEVER rejected on the check character — see validation.ts.
  gstin     String   @default("")
  pan       String   @default("")
  addr      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects  Project[]
  employees Person[]  @relation("employer")
  docs      DocLog[]

  @@map("company")
}

enum ReraStatus {
  received
  applied
  notyet
  na
}

enum ProjectStage {
  pre
  building
  handover
  closed
}

model Project {
  id         String       @id
  name       String
  short      String
  companyId  String
  company    Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  reraStatus ReraStatus   @default(notyet)
  rera       String       @default("")
  stage      ProjectStage @default(pre)
  addr       String       @default("")
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  offices Office[]

  @@index([companyId])
  @@map("project")
}

/// Somewhere a person physically sits. `projectId` is null for the Head Office.
model Office {
  id        String   @id
  name      String
  short     String
  tint      String   @default("#224A85")
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  people Person[]

  @@index([projectId])
  @@map("office")
}

// ------------------------------------------------------------------ people

enum PersonStatus {
  active
  exited
}

/// As the person themselves states it. `undisclosed` is a real answer given by
/// somebody who was asked; a NULL column means nobody has asked yet. HR reports
/// on those separately, so do not collapse them. Never inferred from a name.
enum Gender {
  female
  male
  other
  undisclosed
}

model Person {
  /// MB-PUR-0012. Human-facing, printed on the card, so it is the primary key.
  id          String       @id
  name        String
  designation String
  dept        String
  type        String       @default("Staff")
  /// Display form, "05 Jun 2020". Kept as text because it is what letters merge.
  joined      String
  /// Sortable copy of `joined`. Written by the API, never by a client.
  joinedOn    DateTime?
  dob         String?
  dobOn       DateTime?
  /// NULL means not asked yet — distinct from `undisclosed`. See the enum.
  gender      Gender?
  status      PersonStatus @default(active)
  exitedOn    String?
  perf        Int          @default(75)
  growth      String       @default("")
  photo       String?

  shiftIn    String @default("09:30")
  shiftOut   String @default("18:30")
  shiftHours Float  @default(9)

  /// WHERE THEY SIT.
  officeId String
  office   Office @relation(fields: [officeId], references: [id], onDelete: Restrict)

  /// WHO PAYS THEM. Not derivable from officeId. See the header of this file.
  employerId String
  employer   Company @relation("employer", fields: [employerId], references: [id], onDelete: Restrict)

  reportsToId String?
  reportsTo   Person?  @relation("reports", fields: [reportsToId], references: [id], onDelete: SetNull)
  reports     Person[] @relation("reports")

  /// True when the row arrived through Bulk intake rather than being keyed in.
  imported  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notes    PersonNote[]
  contact  Contact?
  kyc      Kyc?
  salary   Salary?
  devices  Device[]
  cards    Card[]
  exits    Exit[]
  users    User[]
  docs     DocLog[]

  @@index([dept])
  @@index([officeId])
  @@index([employerId])
  @@index([reportsToId])
  @@index([status])
  @@index([gender])
  @@map("person")
}

model PersonNote {
  id        String   @id @default(cuid())
  personId  String
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  when      String
  text      String
  createdAt DateTime @default(now())

  @@index([personId])
  @@map("person_note")
}

/// PERSONAL phone and email only. The company address is closed the day they
/// leave, which makes it useless for exactly the letters we need to send.
/// Aadhaar, PAN and home address.
///
/// A separate table, not columns on Person, for the same reason Salary is one:
/// it can be withheld from a payload in its entirety rather than filtered field
/// by field. Aadhaar in particular is regulated under the Aadhaar Act and the
/// DPDP Act 2023 — it is stored because an employer needs it for PF, ESI and
/// TDS, and it is read by HR and above only.
model Kyc {
  personId  String   @id
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  aadhaar   String   @default("")
  pan       String   @default("")
  address   String   @default("")
  updatedAt DateTime @updatedAt

  @@map("kyc")
}

/// A sold or allotted flat, and the people whose names are on it.
///
/// Residents are not employees and share nothing with them but a phone number
/// field, so they live in their own table. A unit can carry up to four
/// applicants; the first is the one correspondence goes to.
model Unit {
  /// "A-101". The unit number is how everyone refers to it, so it is the key.
  id      String  @id
  tower   String
  /// Which project this tower belongs to. Null until someone confirms it —
  /// the source data names the tower but never the project.
  firmId  String?
  firm    Firm?   @relation(fields: [firmId], references: [id], onDelete: SetNull)
  address String  @default("")
  phone1  String  @default("")
  phone2  String  @default("")
  email1  String  @default("")
  email2  String  @default("")

  applicants Applicant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tower])
  @@map("unit")
}

model Applicant {
  id     String @id @default(cuid())
  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)
  /// 1 is the first applicant, who correspondence is addressed to.
  seq    Int
  name   String
  pan    String @default("")

  @@unique([unitId, seq])
  @@index([unitId])
  @@map("applicant")
}

model Contact {
  personId  String   @id
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  phone     String   @default("")
  email     String   @default("")
  vPhone    Boolean  @default(false)
  vEmail    Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@map("contact")
}

/// Money. Read access is gated to HR and above; see the salary route guard.
model Salary {
  personId  String   @id
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  basic     Int      @default(0)
  hra       Int      @default(0)
  special   Int      @default(0)
  pf        Int      @default(0)
  pt        Int      @default(0)
  note      String   @default("")
  updatedAt DateTime @updatedAt

  @@map("salary")
}

model Device {
  id       String @id @default(cuid())
  personId String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  type     String
  model    String @default("")
  /// Luhn-checked on the way in when it is not the em-dash placeholder.
  imei     String @default("")
  sim      String @default("")
  issued   String

  createdAt DateTime @default(now())

  @@index([personId])
  @@map("device")
}

// ------------------------------------------------------------------- cards

model Card {
  id       String @id @default(cuid())
  personId String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  /// Denormalised on purpose: the log must still read correctly if the person is
  /// later renamed. It records what was printed, not who they are now.
  name     String
  ver      Int
  reason   String
  at       String
  by       String
  recv     String @default("—")
  note     String @default("")
  /// Which version this issue cancelled, e.g. "v2".
  killed   String?
  /// True when the card was unaccounted for and its zone access was revoked.
  zonesKilled Boolean @default(false)

  // The long form, present only when the old card did not come back.
  circumstances String?
  lastHeld      String?
  toldWho       String?
  firNumber     String?

  issuedById String?
  createdAt  DateTime @default(now())

  /// Two people on two screens must not both be handed "version 3".
  @@unique([personId, ver])
  @@index([personId])
  @@map("card")
}

// ------------------------------------------------------------------ ledger

/// APPEND ONLY. A database trigger raises an exception on UPDATE or DELETE —
/// see migration `ledger_append_only`. Application code cannot bypass it and
/// neither can a bug. Seals are SHA-256, computed server-side only.
model LedgerEntry {
  id      String @id @default(cuid())
  /// Chain order. Gapless and monotonic; the verifier walks it ascending.
  seq     Int    @unique @default(autoincrement())
  at      String
  who     String
  kind    String
  subject String
  detail  String
  /// The seal of the entry before this one — and UNIQUE, which is what stops the
  /// chain forking. Without it two entries can name the same predecessor and the
  /// ledger becomes a tree: two histories, both internally consistent, no way to
  /// say which is the real one. It is declared here rather than only in SQL
  /// because a hand-written index is invisible to `prisma migrate diff`, which
  /// once generated a migration that dropped it as drift.
  prev    String @unique
  seal    String @unique

  createdAt DateTime @default(now())

  @@index([kind])
  @@index([subject])
  @@map("ledger_entry")
}

// ------------------------------------------------------------------- exits

model Exit {
  id       String @id @default(cuid())
  personId String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  stage    String @default("decision")
  reason   String
  opened   String
  closedAt String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps ExitStep[]

  @@index([personId])
  @@index([stage])
  @@map("exit")
}

/// One row per stage cleared. The Exit row says where it is now; these say how
/// it got there, who did each step and what they recorded.
model ExitStep {
  id      String @id @default(cuid())
  exitId  String
  exit    Exit   @relation(fields: [exitId], references: [id], onDelete: Cascade)
  stage   String
  payload Json   @default("{}")
  summary String
  byId    String?
  by      User?  @relation(fields: [byId], references: [id], onDelete: SetNull)
  at      DateTime @default(now())

  /// A stage is cleared once. Re-clearing it would silently rewrite the record.
  @@unique([exitId, stage])
  @@index([exitId])
  @@map("exit_step")
}

// ---------------------------------------------------------------- policies

/// Each department keeps its own clock, set by its own manager. The store opens
/// at 08:00 because site starts at 08:00; Accounts opens at 10:00. One global
/// office-hours setting is wrong for this business.
model DeptRule {
  dept      String   @id
  in        String
  out       String
  hours     Float
  days      String
  grace     Int      @default(0)
  setBy     String
  note      String   @default("")
  updatedAt DateTime @updatedAt

  @@map("dept_rule")
}

model LeavePolicy {
  dept      String   @id
  casual    Int      @default(0)
  sick      Int      @default(0)
  earned    Int      @default(0)
  halfDay   String   @default("")
  lateAfter Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("leave_policy")
}

// -------------------------------------------------------- documents and JDs

model DocLog {
  id        String   @id @default(cuid())
  at        String
  tpl       String
  personId  String
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  /// print | email | file
  via       String
  subject   String   @default("")
  body      String   @default("")
  byId      String?
  by        User?    @relation(fields: [byId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([personId])
  @@index([tpl])
  @@map("doc_log")
}

model JobDescription {
  role      String   @id
  jd        String
  updatedBy String   @default("")
  updatedAt DateTime @updatedAt

  @@map("job_description")
}

// ------------------------------------------------------------------- usage

/// Counts every action so you can see which parts get used. Persisted, so it no
/// longer resets on reload the way the browser-only build did.
model UsageCounter {
  key       String   @id
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("usage_counter")
}

/// Plain activity feed for the HR desk. Distinct from the ledger: this one is
/// allowed to be pruned, the ledger is not.
model HrLog {
  id        String   @id @default(cuid())
  at        String
  who       String
  what      String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("hr_log")
}

// =========================================================================
//  PROCUREMENT, GATE, ACCOUNTS AND SALES
//
//  Added when MarbellaProcurementOS.jsx became the application. The HR models
//  above are unchanged: that file contains the whole HR system as a subset, so
//  it reads the same tables.
//
//  Money is stored in PAISE (integers), never as a float. `amt Int` holding
//  780000000 is seven crore eighty lakh exactly; a Float would hold it
//  approximately, and "approximately" is not a thing to say about a purchase
//  order. Quantities stay Float because 18.4 tonnes of steel is a real number.
// =========================================================================

/// A legal entity + project pair as procurement sees it. The `firms` switcher
/// at the top of every screen selects one of these.
model Firm {
  id        String   @id
  short     String
  name      String
  firm      String
  gstin     String   @default("")
  rera      String   @default("")
  stage     String   @default("building")
  addr      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("firm")

  units Unit[]
}

enum VendorStatus {
  unverified
  pending
  verified
}

model Vendor {
  /// MB-STL-0007 — the trade code, human-facing.
  code      String       @id
  name      String
  cat       String       @default("")
  terms     String       @default("")
  phone     String       @default("")
  whatsapp  String       @default("")
  email     String       @default("")
  contact   String       @default("")
  gst       String       @default("")
  pan       String       @default("")
  status    VendorStatus @default(unverified)
  /// Issued only once verification passes. Blank until then.
  vcode     String       @default("")
  city      String       @default("")
  credit    String       @default("")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  purchaseOrders PurchaseOrder[]

  @@index([status])
  @@index([cat])
  @@map("vendor")
}

model PurchaseOrder {
  /// PO-4471.
  id         String   @id
  vendorCode String?
  vendor     Vendor?  @relation(fields: [vendorCode], references: [code], onDelete: SetNull)
  /// Denormalised: the PO must still read correctly if a vendor is renamed.
  vendorName String
  item       String
  /// Paise. BigInt because Int is 32-bit and a crore in paise overflows it.
  amt        BigInt
  status     String   @default("Approved")
  firmId     String?
  /// Delivery record: flag, who drove, what arrived vs what was ordered.
  del        Json?
  raisedById String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  gatePasses GatePass[]

  @@index([status])
  @@index([vendorCode])
  @@map("purchase_order")
}

/// A request from a site for something it needs. Becomes a PO, or is dismissed.
model PurchaseRequest {
  id        String   @id
  item      String
  qty       String
  when      String   @default("")
  proj      String   @default("")
  by        String   @default("")
  /// open | fulfilled | dismissed. Rows are never deleted: a dismissed request
  /// is a decision someone made and should stay answerable for.
  state     String   @default("open")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([state])
  @@map("purchase_request")
}

/// A department asking the store for stock it already holds.
model Requisition {
  id        String   @id
  dept      String
  item      String
  qty       String   @default("")
  state     String   @default("open")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([state])
  @@map("requisition")
}

model InventoryItem {
  /// The item name is the key: the store talks about "OPC 53 cement", not #417.
  item      String   @id
  unit      String
  qty       Float    @default(0)
  reorder   Float    @default(0)
  loc       String   @default("")
  proj      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  holds Hold[]

  @@map("inventory_item")
}

/// Stock reserved against a future need. Held stock is still on the shelf but
/// is NOT available, and the store must be told who to ask before releasing it.
model Hold {
  id        String        @id @default(cuid())
  itemName  String
  item      InventoryItem @relation(fields: [itemName], references: [item], onDelete: Cascade)
  qty       Float
  unit      String        @default("")
  days      Int           @default(0)
  by        String
  why       String        @default("")
  createdAt DateTime      @default(now())

  @@index([itemName])
  @@map("hold")
}

/// Every movement in or out. Append-only in practice: corrections are new rows.
model StockMove {
  id        String   @id @default(cuid())
  /// in | out
  dir       String
  item      String
  qty       Float
  unit      String   @default("")
  ref       String   @default("")
  bill      String   @default("")
  who       String   @default("")
  note      String   @default("")
  createdAt DateTime @default(now())

  @@index([item])
  @@index([createdAt])
  @@map("stock_move")
}

/// How much of an item a site may hold. Exceeding it needs an override.
model StorageCap {
  id        String   @id @default(cuid())
  item      String
  proj      String
  max       Float
  unit      String   @default("")
  why       String   @default("")
  updatedAt DateTime @updatedAt

  @@unique([item, proj])
  @@map("storage_cap")
}

model GatePass {
  id        String         @id
  poId      String?
  po        PurchaseOrder? @relation(fields: [poId], references: [id], onDelete: SetNull)
  vendor    String
  items     String
  /// Paise. 64-bit: see the note on PurchaseOrder.amt.
  total     BigInt         @default(0)
  by        String
  status    String         @default("expected")
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([status])
  @@map("gate_pass")
}

/// What the gate decided, and who decided it. Never edited after the fact.
model GateEvent {
  id       String   @id @default(cuid())
  /// permit | deny
  outcome  String
  label    String
  plate    String   @default("")
  guard    String   @default("")
  guardId  String   @default("")
  post     String   @default("")
  who      String   @default("")
  note     String   @default("")
  /// Photographs taken at the gate.
  evidence Json     @default("[]")
  at       DateTime @default(now())

  @@index([outcome])
  @@index([at])
  @@map("gate_event")
}

/// A document sent from one department to another, with its revision history.
model Submittal {
  id        String   @id
  title     String
  fromName  String
  fromDept  String
  to        String
  status    String   @default("sent")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions SubmittalVersion[]

  @@index([status])
  @@map("submittal")
}

model SubmittalVersion {
  id          String    @id @default(cuid())
  submittalId String
  submittal   Submittal @relation(fields: [submittalId], references: [id], onDelete: Cascade)
  v           Int
  fileName    String
  by          String
  note        String    @default("")
  at          DateTime  @default(now())

  @@unique([submittalId, v])
  @@map("submittal_version")
}

// ----------------------------------------------------------------- accounts

model VendorInvoice {
  id        String   @id
  from      String   @default("")
  vendor    String
  subj      String   @default("")
  /// Paise, 64-bit.
  amt       BigInt   @default(0)
  po        String   @default("")
  gstin     Boolean  @default(false)
  age       String   @default("")
  /// toclear | cleared | query
  state     String   @default("toclear")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([state])
  @@map("vendor_invoice")
}

model Expense {
  id        String   @id
  cat       String
  dept      String
  /// Paise, 64-bit.
  amt       BigInt
  party     String   @default("")
  date      String   @default("")
  src       String   @default("")
  how       String   @default("")
  ok        Boolean  @default(true)
  note      String   @default("")
  createdAt DateTime @default(now())

  @@index([cat])
  @@index([dept])
  @@map("expense")
}

model Sale {
  id        String   @id
  unit      String
  tower     String   @default("")
  proj      String   @default("")
  firm      String   @default("")
  plan      String   @default("")
  /// Paise, 64-bit.
  price     BigInt
  booked    String   @default("")
  buyer     String
  phone     String   @default("")
  email     String   @default("")
  /// Stage-wise receipts and what is still due.
  received  Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reminders PaymentReminder[]

  @@index([proj])
  @@map("sale")
}

/// A payment chase. Drafted by anyone, but it does not go out until approved —
/// a reminder is a letter to a customer about money and carries the firm's name.
model PaymentReminder {
  id         String   @id @default(cuid())
  saleId     String?
  sale       Sale?    @relation(fields: [saleId], references: [id], onDelete: SetNull)
  buyer      String   @default("")
  channel    String   @default("")
  subject    String   @default("")
  body       String   @default("")
  approved   Boolean  @default(false)
  approvedBy String?
  createdAt  DateTime @default(now())

  @@index([approved])
  @@map("payment_reminder")
}

model BankAccount {
  id        String   @id
  bank      String
  acc       String
  type      String   @default("")
  firm      String   @default("")
  till      String   @default("")
  /// Statement months not yet uploaded.
  gaps      Json     @default("[]")
  /// Paise, 64-bit.
  bal       BigInt   @default(0)
  updatedAt DateTime @updatedAt

  @@map("bank_account")
}

model CreditCard {
  id        String   @id
  bank      String
  last      String
  holder    String
  /// Paise, 64-bit.
  limit     BigInt   @default(0)
  used      BigInt   @default(0)
  cycle     String   @default("")
  due       String   @default("")
  firm      String   @default("")
  updatedAt DateTime @updatedAt

  @@map("credit_card")
}

/// A counterparty in Masters — own firms, buyers, suppliers.
model MasterCompany {
  id        String   @id
  name      String
  kind      String   @default("")
  gstin     String   @default("")
  pan       String   @default("")
  city      String   @default("")
  updatedAt DateTime @updatedAt

  @@map("master_company")
}

// ------------------------------------------------------- rates and requests

/// What things cost. Learned from every PO line that gets raised, so the next
/// PO can warn when a rate has moved.
model CatalogItem {
  name      String   @id
  unit      String   @default("")
  /// Paise per unit, 64-bit.
  rate      BigInt   @default(0)
  vendor    String   @default("")
  updatedAt DateTime @updatedAt

  @@map("catalog_item")
}

/// Something a person raised from the floor: missing material, safety, support.
model SiteReport {
  id        String   @id @default(cuid())
  cat       String
  by        String
  proj      String   @default("")
  text      String   @default("")
  severity  String   @default("low")
  /// Voice note and photo evidence.
  media     Json     @default("[]")
  state     String   @default("open")
  createdAt DateTime @default(now())

  @@index([cat])
  @@index([state])
  @@map("site_report")
}

// ------------------------------------------------------ people extras, calendar

model CalendarEvent {
  id        String   @id @default(cuid())
  title     String
  /// ISO date, e.g. 2026-08-05.
  date      String
  time      String   @default("")
  kind      String   @default("task")
  priority  String   @default("normal")
  /// { type: "all" } | { type: "dept", dept } | { type: "people", ids }
  audience  Json     @default("{\"type\":\"all\"}")
  by        String   @default("")
  note      String   @default("")
  createdAt DateTime @default(now())

  @@index([date])
  @@map("calendar_event")
}

/// An incentive scheme. Proposed, then approved or declined, then issued.
model IncentivePackage {
  id        String   @id @default(cuid())
  name      String
  /// Paise, 64-bit.
  amount    BigInt
  threshold Float    @default(0)
  scale     Float    @default(10)
  dept      String   @default("")
  period    String   @default("")
  how       String   @default("")
  status    String   @default("proposed")
  issuedTo  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("incentive_package")
}

/// One person, one day, from the biometric export.
model AttendanceDay {
  id        String   @id @default(cuid())
  personId  String
  /// Display form as the importers give it, e.g. "28 Jul".
  date      String
  /// Null means absent.
  inAt      String?
  outAt     String?
  source    String   @default("")
  createdAt DateTime @default(now())

  @@unique([personId, date])
  @@index([personId])
  @@map("attendance_day")
}

/// HR's own running log and task list. Prunable, unlike the ledger.
model HrTask {
  id        String   @id @default(cuid())
  text      String
  who       String   @default("")
  due       String   @default("")
  done      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("hr_task")
}

model Announcement {
  id        String   @id @default(cuid())
  text      String
  by        String   @default("")
  createdAt DateTime @default(now())

  @@map("announcement")
}

// ---------------------------------------------------------------- platform

/// Third-party connections. The TOKEN IS NEVER STORED HERE in plain text —
/// this records only that a connection exists and who made it.
model Connection {
  key         String    @id
  connected   Boolean   @default(false)
  connectedBy String?
  connectedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@map("connection")
}

/// Who took what out of the system, and when. Exports leave the building.
model ExportRecord {
  id        String   @id @default(cuid())
  key       String
  title     String
  rows      Int      @default(0)
  period    String   @default("")
  byId      String?
  createdAt DateTime @default(now())

  @@index([key])
  @@map("export_record")
}

/// A half-finished form, so closing a screen mid-way does not lose the typing.
model Draft {
  id        String   @id @default(cuid())
  userId    String
  type      String
  label     String   @default("")
  data      Json     @default("{}")
  updatedAt DateTime @updatedAt

  /// One live draft per form per person.
  @@unique([userId, type])
  @@map("draft")
}

/// Access grants: which areas a role may see, change, approve and export.
/// Replaces the browser-only grant map that announced "Access updated" and
/// then forgot it the moment the screen closed.
model AccessGrant {
  id        String   @id @default(cuid())
  /// The USERS key: admin, purchase, store, hr, ...
  userKey   String
  area      String
  /// view | edit | approve | export
  power     String
  granted   Boolean  @default(false)
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@unique([userKey, area, power])
  @@index([userKey])
  @@map("access_grant")
}
