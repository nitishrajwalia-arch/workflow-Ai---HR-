{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    /* Composite projects must emit declarations, so they go to a scratch dir
       that is never shipped. `emitDeclarationOnly` keeps the JS out of it. */
    "composite": true,
    "emitDeclarationOnly": true,
    "outDir": "./node_modules/.tmp/types-node",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },
  "include": ["vite.config.ts"]
}
