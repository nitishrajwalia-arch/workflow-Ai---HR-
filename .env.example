# ==========================================================================
#  Marbella Procurement OS — configuration
#
#  Copy to .env and fill in. `npm run setup` will tell you what is missing,
#  by name, before the server starts rather than at 3am on the first request
#  that happens to need it.
#
#  Never commit a real .env. It is in .gitignore for a reason.
# ==========================================================================

# ---------------------------------------------------------------- database
# The user this connects as should own the schema but NOT be a superuser: a
# superuser can drop the ledger's append-only triggers.
DATABASE_URL="postgresql://marbella:change-me@localhost:5432/marbella?schema=public"

# Connections this process may hold. Sizing: (pool * instances) must stay
# under Postgres's max_connections, with room for migrations and psql.
DATABASE_POOL_MAX=10

# ------------------------------------------------------------------ server
NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# Turn on when the API sits behind nginx/Caddy/a load balancer, so rate
# limiting sees the real client IP instead of the proxy's.
TRUST_PROXY=true

# -------------------------------------------------------------------- auth
# REQUIRED. 32 characters minimum. Generate with:
#     openssl rand -base64 48
# Changing it signs everyone out, which is the correct response to a leak.
JWT_SECRET="CHANGE-THIS-generate-with-openssl-rand-base64-48"

# Short, because it cannot be revoked before it expires. The refresh token is
# what gives a long session; this is what limits the damage of a stolen one.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Wrong passwords in a row before the account locks, and for how long.
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCKOUT_MINUTES=15

# ------------------------------------------------------ the override code
# The Chairman's code, for the few actions that can only proceed with it —
# breaching a storage cap, mainly. Checked at POST /api/v1/override/verify,
# rate-limited to five tries a minute, and EVERY attempt, accepted or
# refused, is sealed into the ledger.
#
# It lives here and not in the browser bundle, where it used to be: anything
# in the bundle is readable by anyone who opens devtools. 4 characters
# minimum. Leave it unset and the server refuses every override rather than
# waving them through — which is the right way round.
#
# It is one shared code, not one per person. Rotate it when someone who knew
# it leaves.
OVERRIDE_PIN=

# -------------------------------------------------------------------- CORS
# Comma-separated origins allowed to call the API with credentials.
# If the web app is served from the same origin (the recommended setup — see
# docs/DEPLOYMENT.md) this is only needed for local development.
CORS_ORIGINS=https://ops.marbellagroup.in

# -------------------------------------------------------------- rate limits
RATE_LIMIT_MAX=300
# Much tighter: this is the route where guessing is the threat.
RATE_LIMIT_AUTH_MAX=10

# ----------------------------------------------------------------- logging
LOG_LEVEL=info
# Human-readable logs. Never in production — the log shipper wants JSON.
LOG_PRETTY=false

# ----------------------------------------------------------------- uploads
# Must be on a persistent volume. A container filesystem is not one: photos
# written there vanish on the next deploy.
UPLOAD_DIR=/var/lib/marbella/uploads
UPLOAD_MAX_BYTES=5242880

# -------------------------------------------------------------------- docs
# The OpenAPI reference at /docs. Leave on: an API nobody can read is an API
# nobody uses. Turn off only if the API is on the public internet unproxied.
ENABLE_DOCS=true

# ------------------------------------------------------- first-run account
# Used ONLY when the database has no users at all. Leave the password unset
# and the seed generates one and prints it once. Either way the account must
# change it at first sign-in.
BOOTSTRAP_ADMIN_EMAIL=hr@marbellagroup.in
BOOTSTRAP_ADMIN_NAME="Simran Kaur"
# BOOTSTRAP_ADMIN_PASSWORD=

# --------------------------------------------------------------- front end
# Leave UNSET when the web app and API share an origin, which is the setup
# docs/DEPLOYMENT.md describes. Set it only if they are on different hosts —
# and then that host must be listed in CORS_ORIGINS above.
# VITE_API_URL=https://api.marbellagroup.in
